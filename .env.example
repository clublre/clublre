# ─────────────────────────────────────────────────────────────────
# Club LRE — variables de entorno
# ─────────────────────────────────────────────────────────────────
#
# Copiá este archivo a `.env.local` y completá los valores cuando
# tengas las credenciales del club. Ver STACK.md §7 para el detalle
# de cada variable.
#
# Variables con prefijo `NEXT_PUBLIC_` son visibles en el cliente.
# Variables SIN ese prefijo son server-only y NUNCA se envían al
# browser — guardan secretos.
#
# ─────────────────────────────────────────────────────────────────

# ─── Supabase ──────────────────────────────────────────────────
# Crear proyecto en https://supabase.com/dashboard (región sa-east-1).
# Settings → API → copiar Project URL y anon/service_role keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                # server-only — NUNCA NEXT_PUBLIC_

# ─── Site ──────────────────────────────────────────────────────
# URL pública del sitio. Usada por metadata, sitemap, robots, OG.
NEXT_PUBLIC_APP_URL=https://clublre.com.ar

# ─── Resend ─────────────────────────────────────────────────────
# Crear cuenta en https://resend.com. Verificar dominio clublre.com.ar
# (registros SPF, DKIM, DMARC en el DNS).
# Free tier: 3.000 emails/mes.

RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@clublre.com.ar

# ─── Cloudflare Turnstile ───────────────────────────────────────
# Crear widget en https://dash.cloudflare.com → Turnstile.
# Site key es pública; secret es server-only.

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Vercel Speed Insights ─────────────────────────────────────
# No requiere env var. El componente <SpeedInsights /> detecta
# automáticamente si está en prod (Vercel) o dev (no-op).

# ─── Notas ──────────────────────────────────────────────────────
# - Las claves con NEXT_PUBLIC_ son legibles en el bundle del
#   cliente. Auditar regularmente con:
#     grep -r "NEXT_PUBLIC_" . --include="*.ts" --include="*.tsx"
# - SUPABASE_SERVICE_ROLE_KEY bypasea RLS. Usar SOLO en Server
#   Components / Server Actions / Route Handlers. NUNCA importar
#   en Client Components.
# - Las claves reales van en .env.local (ignorado por git) y en
#   las env vars de Vercel para deploys.
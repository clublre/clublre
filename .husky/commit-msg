#!/usr/bin/env bash
# Valida Conventional Commits: <type>(<scope>): <subject>
# Tipos permitidos: feat, fix, refactor, chore, docs, style, test, perf, build, ci
# Subject: lowercase, ≤72 chars idealmente (warn si pasa), sin punto final.

commit_msg_file="$1"
commit_msg="$(cat "$commit_msg_file")"

# Ignora mensajes merge y revert
if echo "$commit_msg" | grep -qE '^Merge |^Revert '; then
  exit 0
fi

# Regex de Conventional Commits
pattern='^(feat|fix|refactor|chore|docs|style|test|perf|build|ci)(\([a-z0-9_-]+\))?!?: .{3,72}$'

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "❌ Commit message no sigue Conventional Commits."
  echo ""
  echo "Formato requerido: <type>(<scope>): <subject>"
  echo ""
  echo "Tipos: feat, fix, refactor, chore, docs, style, test, perf, build, ci"
  echo ""
  echo "Ejemplos:"
  echo "  feat(pricing): agregar destacado al plan familiar"
  echo "  fix(navbar): aria-label en botón mobile"
  echo "  chore(deps): bump next a 16"
  echo ""
  echo "Tu mensaje:"
  echo "  $commit_msg" | head -1
  echo ""
  echo "Para bypass: git commit --no-verify"
  exit 1
fi

exit 0
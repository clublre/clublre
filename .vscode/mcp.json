{
  "servers": {
    "heroui-react": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@heroui/react-mcp@latest"]
    },
    "next-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "codebase-memory-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "codebase-memory-mcp@latest"],
      "env": {
        "CBM_CACHE_DIR": "${workspaceFolder}/.codebase-memory"
      }
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking@latest"]
    }
  }
}
